# Ajouter ces variables au .env privé du backend, sans remplacer ses autres valeurs.
# Ne jamais placer une clé dans mobile/.env, EXPO_PUBLIC_* ou Git.
CLOTHING_VISION_PROVIDER=gemini
GEMINI_API_KEY=
CLOTHING_VISION_MODEL=gemini-3.5-flash-lite

# Limites locales par processus Node, hors quotas du fournisseur.
CLOTHING_VISION_PER_USER_HOUR=20
CLOTHING_VISION_GLOBAL_DAY=200

# Recherche visuelle complémentaire : fournisseur tiers SerpApi.
# Active le complément au préremplissage si une clé est présente.
SERPAPI_API_KEY=

# Mettre 0 pour garder uniquement Gemini dans l’application.
CLOTHING_VISUAL_SEARCH=1
